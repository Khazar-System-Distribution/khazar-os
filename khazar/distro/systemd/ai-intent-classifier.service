[Unit]
Description=Khazar AI Intent Classifier (Tier 1)
After=network.target ai-model-runtime.service

[Service]
Type=simple
ExecStart=/var/lib/khazar/bin/ai-intent-classifier /etc/khazar/intent-classifier.toml
Restart=always
RestartSec=5
User=khazar
Group=khazar

[Install]
WantedBy=multi-user.target
