[Unit]
Description=AI Rule Engine - Tier 0 Inference System
Documentation=https://github.com/khazar/ai-rule-engine
After=network.target

[Service]
Type=forking
PIDFile=/run/ai-rule-engine.pid
ExecStart=/usr/local/bin/ai-rule-engine /etc/ai-rule-engine.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
User=root
Group=root
Nice=-5
LimitNOFILE=1024
MemoryMax=50M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
